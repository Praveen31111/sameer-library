# Root level gitignore for Sameer Library Multi-Platform Project

# Node Modules
node_modules/
*/node_modules/

# Environment files
.env
.env*
!.env.example
!*/.env.example

# Next.js build output
.next/
*/.next/
out/
*/out/

# Expo / React Native
.expo/
*/.expo/
dist/
*/dist/
web-build/
*/web-build/

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated
.DS_Store
Thumbs.db
