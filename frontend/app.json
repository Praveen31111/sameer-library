{
  "expo": {
    "name": "Sameer Library",
    "slug": "sameer-library",
    "scheme": [
      "sameerlibrary",
      "com.googleusercontent.apps.560988320829-31goecj69287hpnbbm0vhuhrt6bjbl2v"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b192c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.praveen.sameerlibrary",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.560988320829-31goecj69287hpnbbm0vhuhrt6bjbl2v"
            },
            {
              "scheme": "com.praveen.sameerlibrary"
            },
            {
              "scheme": "sameerlibrary"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b192c"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "67779ad3-f164-4599-9a11-456dd430db38"
      }
    },
    "owner": "praveen-chaudharys-team"
  }
}
