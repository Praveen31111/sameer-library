{
  "expo": {
    "name": "Sameer Library",
    "slug": "sameer-library-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b192c"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.praveen.sameerlibrary",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b192c"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c76f057e-c2d3-4e66-b257-0c53a9ea9743"
      }
    }
  }
}
