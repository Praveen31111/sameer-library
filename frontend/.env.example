# ========================================================
# SAMEER LIBRARY MOBILE APP CONFIGURATION
# ========================================================

# Backend API URL:
# For local dev testing on physical device / emulator, the app automatically 
# detects your local LAN IP (e.g. http://192.168.x.x:3000/api).
# 
# For production builds (EAS / APK), set this to your deployed Next.js backend URL:
EXPO_PUBLIC_API_URL="https://your-production-domain.com/api"

# Google Sign-In Web Client ID (from Firebase Console / Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
